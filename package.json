{
  "name": "forge",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @repo/web dev",
    "dev:mobile": "pnpm --filter @repo/mobile dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "db:seed": "pnpm --filter @repo/db db:seed"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "overrides": {
    "@react-native/codegen": "0.86.3",
    "@react-native/babel-plugin-codegen": "0.86.3",
    "@react-native/babel-preset": "0.86.3"
  },
  "engines": {
    "node": ">=20"
  }
}
